# Copy to .env.local. Secrets must never use a VITE_ prefix.
# Required for authenticated dining search; authorized for the hackathon host.
QLOO_API_KEY=

# Optional server-only AI interpretation. Without it, Profile-based search works.
# Free-plan key: https://console.groq.com/keys
# Selected model is fixed in the adapter: openai/gpt-oss-20b
GROQ_API_KEY=

# Required for public/production use across multiple instances.
# Configure your own Redis REST store; none is provisioned by this project.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
USAGE_CALLER_SALT=
